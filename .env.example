# Supabase — leave blank to run the site in static/offline mode (no auth, no admin writes).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: comma-separated emails allowed into /admin. Empty = any authenticated user.
ADMIN_EMAILS=

# Optional flag overrides (true/false). Override the defaults in src/lib/flags.ts.
# NEXT_PUBLIC_FLAG_CLUSTER_PRODUCTS=false
# NEXT_PUBLIC_FLAG_CLUSTER_VIDEOS=true
