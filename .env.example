# Supabase — leave both blank to run the site in static/offline mode
# (no auth, no admin writes, no video uploads). Full walkthrough: SUPABASE_SETUP.md
#
# Both keys are PUBLIC by design (the NEXT_PUBLIC_ prefix ships them to the browser).
# Find them in the dashboard: Settings → API.
#   Project URL          -> NEXT_PUBLIC_SUPABASE_URL    (e.g. https://<ref>.supabase.co)
#   anon / public key    -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# NEVER put the service_role key here, and never use the Postgres connection string —
# this app talks to Supabase over the Project URL + anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated emails allowed into /admin (manage resources + upload videos).
# Empty = ANY authenticated user. Always set this for a real deployment.
ADMIN_EMAILS=

# Optional flag overrides (true/false). Override the defaults in src/lib/flags.ts.
# NEXT_PUBLIC_FLAG_CLUSTER_PRODUCTS=false
# NEXT_PUBLIC_FLAG_CLUSTER_VIDEOS=true
